PROXY_CONFIG_REDIS_HOST=127.0.0.1

# PROXY_CONFIG_REDIS_PORT=
# PROXY_CONFIG_REDIS_PASSWORD=
# PROXY_CONFIG_REDIS_TLS=

PROXY_CONFIG_MYSQL_HOST=127.0.0.1
PROXY_CONFIG_MYSQL_PORT=3306

# PROXY_CONFIG_MYSQL_USER=
# PROXY_CONFIG_MYSQL_PASSWORD=
# PROXY_CONFIG_MYSQL_DATABASE=

# PROXY_CONFIG_MYSQL_CONNLIMIT=20

# Our own domains: a destination on one of them (or a subdomain) is delivered only when it is one of the exact URLs
# PROXY_CONFIG_PROTECTED_DOMAINS=example.com,example.org
# An entry: <url>, or <application uuid>|<url> (only the webhooks of that application)
# PROXY_CONFIG_PROTECTED_ALLOWED_URLS=00000000-0000-4000-8000-000000000000|https://hooks.example.com/webhook,https://example.org/api/hook

# Reserved address blocks (CIDR, IPv4 and IPv6, comma separated): a destination with an address in one of these blocks
# is refused, except for the exact URLs of PROXY_CONFIG_PROTECTED_ALLOWED_URLS.
# PROXY_CONFIG_RESERVED_ADDRESS_BLOCKS=192.0.2.0/24,2001:db8::/32,198.51.100.7
